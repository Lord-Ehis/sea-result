// Sophie Educational Assistant (SEA) — Result Management
// Multi-tenancy: shared database, `schoolId` acts as the tenant_id column
// on every tenant-scoped table (School is the tenant root).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PLATFORM_OWNER
  SCHOOL_ADMIN
  TEACHER
  PARENT
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum BillingCycle {
  PER_TERM
  FULL_SESSION
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum ResultEventAction {
  SUBMITTED
  SENT_BACK
  APPROVED
  PUBLISHED
  TERM_EXCEPTION_SET
  TERM_EXCEPTION_CLEARED
  AMENDED
}

// What the annual summary does when a student has no published result for an
// earlier term (spec §6.2). Either way nothing is ever counted as zero.
enum IncompleteYearPolicy {
  BLOCK
  CALCULATE_AVAILABLE
}

enum TermExceptionStatus {
  NOT_ENROLLED
  EXEMPT
}

enum PromotionStatus {
  PROMOTED
  RETAINED
  GRADUATED
  PENDING
  NOT_APPLICABLE
}

enum TemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationEvent {
  RESULT_PUBLISHED
  PAYMENT_RECEIVED
  ACCOUNT_CREATED
  PASSWORD_RESET
  RESULT_AMENDED
  SUBSCRIPTION_REMINDER
}

enum ProviderKind {
  PAYSTACK
  SMS_TERMII
  SMS_AFRICAS_TALKING
  EMAIL_RESEND
  EMAIL_POSTMARK
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model School {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  status               SchoolStatus @default(ACTIVE)
  customDomain         String?      @unique
  customDomainVerified Boolean      @default(false)
  resultFormatConfig   Json?
  allowParentAccounts  Boolean      @default(true)
  allowResultLookup    Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  campuses         Campus[]
  users            User[]
  students         Student[]
  classes          Class[]
  resultTemplates  ResultTemplate[]
  results          Result[]
  subscriptions    Subscription[]
  payments         Payment[]
  notifications    Notification[]
  deletionRequests DeletionRequest[]

  templateVersions     TemplateVersion[]
  templateSections     TemplateSection[]
  assessmentComponents AssessmentComponent[]
  gradingScales        GradingScale[]
  gradingScaleBands    GradingScaleBand[]
  ratingCategories     RatingCategory[]
  ratingItems          RatingItem[]
  templateAssignments  TemplateAssignment[]
  resultBatches        ResultBatch[]
  resultEvents         ResultEvent[]
  annualSettings       AnnualSummarySettings?
  termExceptions       StudentTermException[]
  resultSnapshots      PublishedResultSnapshot[]

  @@map("schools")
}

// ---------------------------------------------------------------------------
// Campuses
// ---------------------------------------------------------------------------

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students            Student[]
  classes             Class[]
  templateAssignments TemplateAssignment[]
  adminAccess         UserCampusAccess[]

  @@index([schoolId])
  @@map("campuses")
}

// ---------------------------------------------------------------------------
// Users (role-based)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  // Nullable — Platform Owner accounts are not scoped to a school.
  schoolId     String?
  role         Role
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  isActive     Boolean  @default(true)
  // A campus admin: a SCHOOL_ADMIN who may only see the campuses listed in
  // `campusAccess`. With no rows they see nothing (fail closed) — never "all".
  // Everyone else (false) is unrestricted, exactly as before.
  campusScoped Boolean  @default(false)
  // When this person agreed to the Terms and Privacy Policy at sign-up, and which
  // version of them (src/lib/legal.ts). Empty for accounts made before consent
  // was collected.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  campusAccess UserCampusAccess[]

  // Teacher: classes assigned to this teacher
  teachingAssignments TeacherClassAssignment[]

  // Parent: children linked to this account
  childLinks ParentStudentLink[]

  submittedResults Result[] @relation("SubmittedBy")
  approvedResults  Result[] @relation("ApprovedBy")

  deletionRequestsMade     DeletionRequest[] @relation("RequestedBy")
  deletionRequestsResolved DeletionRequest[] @relation("ResolvedBy")

  notifications Notification[]

  passwordResetTokens PasswordResetToken[]

  @@index([schoolId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Password reset / set-password tokens (forgot-password and invite flows
// share this — an invite just pre-creates a token for a fresh account).
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Classes & assignments
// ---------------------------------------------------------------------------

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  campusId  String
  name      String // e.g. "JSS 1A", "SSS 2 Commerce"
  level     String? // e.g. "JSS 1", "SSS 2"
  session   String // academic session, e.g. "2025/2026"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus              Campus                   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  students            Student[]
  teachers            TeacherClassAssignment[]
  resultTemplates     ResultTemplate[]
  templateAssignments TemplateAssignment[]
  resultBatches       ResultBatch[]

  @@index([schoolId])
  @@index([campusId])
  @@map("classes")
}

model TeacherClassAssignment {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  createdAt DateTime @default(now())

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@map("teacher_class_assignments")
}

// ---------------------------------------------------------------------------
// Students & parent links
// ---------------------------------------------------------------------------

model Student {
  id            String    @id @default(cuid())
  schoolId      String
  campusId      String
  classId       String?
  studentCode   String // unique per school, used for no-login result lookup
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  // Plain contact details for notifications — not a linked parent account.
  // See ParentStudentLink for actual parent/student login access.
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school          School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus          Campus                    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  class           Class?                    @relation(fields: [classId], references: [id])
  parentLinks     ParentStudentLink[]
  results         Result[]
  notifications   Notification[]
  resultSnapshots PublishedResultSnapshot[]
  termExceptions  StudentTermException[]

  @@unique([schoolId, studentCode])
  @@index([schoolId])
  @@index([campusId])
  @@map("students")
}

// A parent/student account can link multiple children; a student can
// have more than one linked guardian.
model ParentStudentLink {
  id           String   @id @default(cuid())
  parentUserId String
  studentId    String
  createdAt    DateTime @default(now())

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@map("parent_student_links")
}

// ---------------------------------------------------------------------------
// Result templates & results
// ---------------------------------------------------------------------------

model ResultTemplate {
  id         String   @id @default(cuid())
  schoolId   String
  classId    String?
  // Targets every class under a level (e.g. "JSS 2") when classId is unset.
  // Falls back further to every class in the school when both are unset.
  level      String?
  name       String
  term       String? // e.g. "Term 2, 2025/2026"
  // 1, 2 or 3 — what makes annual matching possible. `term` above is only a label.
  termNumber Int?
  // Field definitions are school-configurable (subjects, grading scale,
  // comment fields, etc.) — not a single fixed format across schools.
  // Kept as the compute-facing source of truth: entry/review/publish read
  // this column exactly as before. Once a TemplateVersion is activated,
  // this column is derived (compiled) from it — see version-compile.ts.
  fields     Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Which version last compiled into `fields`, if any. Null for templates
  // that have never gone through the versioned builder.
  currentVersionId String?
  currentVersion   TemplateVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class?            @relation(fields: [classId], references: [id])
  results  Result[]
  batches  ResultBatch[]
  versions TemplateVersion[] @relation("TemplateVersions")

  @@index([schoolId])
  @@map("result_templates")
}

// ---------------------------------------------------------------------------
// Result template versioning (spec v1.0 "Configuration foundation")
//
// A ResultTemplate is the reusable identity; a TemplateVersion is an
// immutable revision once activated (an admin duplicates an ACTIVE version
// into a new DRAFT to change anything). Sections/components/rating
// categories live only inside one version, not shared across versions — the
// one deliberately reusable, school-owned exception is GradingScale.
//
// Activating a version compiles it into the legacy `TemplateField[]` shape
// on ResultTemplate.fields (see src/lib/version-compile.ts) so entry,
// review, publish and the compute engine keep working completely unchanged.
// ---------------------------------------------------------------------------

model TemplateVersion {
  id                     String                @id @default(cuid())
  schoolId               String
  templateId             String
  versionNumber          Int
  status                 TemplateVersionStatus @default(DRAFT)
  gradingScaleId         String? // null = falls back to the school's isDefault scale
  // The original Grid TemplateField's own id, preserved across every
  // version of a template once first migrated/activated. Result.data keys
  // for Grid cells are `${gridFieldId}:${subjectId}:${columnId}` (see
  // src/lib/grid-compute.ts) — reusing a different id here would silently
  // orphan every already-scored cell for this template.
  legacyGridFieldId      String?
  // Verbatim passthrough for field types not yet modeled structurally here
  // (Text, Dropdown, Computed incl. promotion/resultAnalysis, comment
  // fields) — ids inside this array are never regenerated.
  legacyFields           Json                  @default("[]")
  // Show the Term 1–3 annual summary on Term 3 results. Part of the immutable
  // version because it changes what the result contains.
  includeAnnualSummary   Boolean               @default(false)
  // Snapshot of exactly what was compiled onto ResultTemplate.fields at
  // activation — audit-log-ready even though no audit log exists yet.
  compiledFieldsSnapshot Json?
  createdByUserId        String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  activatedByUserId      String?
  activatedAt            DateTime?

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template         ResultTemplate       @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor       ResultTemplate[]     @relation("CurrentVersion")
  gradingScale     GradingScale?        @relation(fields: [gradingScaleId], references: [id])
  sections         TemplateSection[]
  ratingCategories RatingCategory[]
  assignments      TemplateAssignment[]

  @@unique([templateId, versionNumber])
  @@index([schoolId])
  @@map("template_versions")
}

model TemplateSection {
  id             String   @id @default(cuid())
  schoolId       String
  versionId      String
  name           String // e.g. "Mathematics" — a Grid "subject"
  displayOrder   Int
  // Set only by the one-time backfill script: the original Grid subject id,
  // so compileVersionToFields can reproduce the exact same composite keys.
  legacySourceId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version    TemplateVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  components AssessmentComponent[]

  @@index([schoolId])
  @@index([versionId])
  @@map("template_sections")
}

model AssessmentComponent {
  id             String   @id @default(cuid())
  schoolId       String
  sectionId      String
  componentName  String // e.g. "1st CA"
  componentCode  String // e.g. "CA1" — unique within a section
  maxScore       Decimal  @db.Decimal(6, 2)
  weightPercent  Decimal  @db.Decimal(5, 2)
  displayOrder   Int
  isRequired     Boolean  @default(true)
  legacySourceId String? // original Grid rawColumn id (migration only)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, componentCode])
  @@index([schoolId])
  @@map("assessment_components")
}

model GradingScale {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands    GradingScaleBand[]
  versions TemplateVersion[]

  @@index([schoolId])
  @@map("grading_scales")
}

model GradingScaleBand {
  id             String @id @default(cuid())
  schoolId       String
  gradingScaleId String
  minScore       Float
  maxScore       Float
  gradeCode      String // e.g. "A"
  remark         String // e.g. "Excellent"
  displayOrder   Int

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([gradingScaleId])
  @@map("grading_scale_bands")
}

model RatingCategory {
  id            String   @id @default(cuid())
  schoolId      String
  versionId     String
  name          String // e.g. "Affective domain"
  displayOrder  Int
  ratingOptions Json     @default("[\"1\",\"2\",\"3\",\"4\",\"5\"]") // string[] shared by items in this category
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version TemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  items   RatingItem[]

  @@index([schoolId])
  @@index([versionId])
  @@map("rating_categories")
}

model RatingItem {
  id             String   @id @default(cuid())
  schoolId       String
  categoryId     String
  name           String // e.g. "Punctuality"
  displayOrder   Int
  isEnabled      Boolean  @default(true)
  legacySourceId String? // original flat "Rating scale" field id (migration only)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category RatingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([categoryId])
  @@map("rating_items")
}

model TemplateAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  versionId String
  classId   String?
  level     String?
  // Part of the full spec shape; not populated by activateVersion in this
  // increment — ResultTemplate has no campus concept to derive it from yet.
  campusId  String?
  term      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  version TemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  class   Class?          @relation(fields: [classId], references: [id])
  campus  Campus?         @relation(fields: [campusId], references: [id])

  @@index([schoolId])
  @@index([versionId])
  @@map("template_assignments")
}

model Result {
  id         String       @id @default(cuid())
  schoolId   String
  studentId  String
  templateId String
  term       String // e.g. "Term 2"
  session    String // e.g. "2025/2026"
  // Subject/score data, shaped to match the ResultTemplate's fields.
  data       Json
  status     ResultStatus @default(DRAFT)

  submittedByUserId String?
  approvedByUserId  String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  publishedAt       DateTime?
  rejectionNote     String?

  // Optimistic locking: every write states the revision it read, so two
  // people editing the same record can't silently overwrite each other.
  revision          Int              @default(0)
  // Null on rows created before batches existed; set on their next teacher save.
  batchId           String?
  // Set by an admin on Term 3 results (spec §4.8); frozen into the snapshot.
  promotionStatus   PromotionStatus?
  promotedToClassId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template    ResultTemplate            @relation(fields: [templateId], references: [id])
  batch       ResultBatch?              @relation(fields: [batchId], references: [id])
  snapshots   PublishedResultSnapshot[]
  submittedBy User?                     @relation("SubmittedBy", fields: [submittedByUserId], references: [id])
  approvedBy  User?                     @relation("ApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([studentId, templateId, term, session])
  @@index([schoolId])
  @@index([status])
  @@index([batchId])
  @@map("results")
}

// The class-level unit of the teacher → admin workflow: one class's results
// for one template, term and session. Row statuses on Result stay the
// authority for review/publish; the batch mirrors them and pins the template
// version it was started under (spec §5: "a batch retains its original
// template version").
model ResultBatch {
  id                String       @id @default(cuid())
  schoolId          String
  classId           String
  templateId        String
  // The template's active version when the batch was created (null for
  // templates that never went through the versioned builder).
  templateVersionId String?
  term              String
  // Copied from the template when the batch is created (or parsed from the label).
  termNumber        Int?
  session           String
  status            ResultStatus @default(DRAFT)
  createdByUserId   String?
  submittedByUserId String?
  submittedAt       DateTime?
  revision          Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  template ResultTemplate @relation(fields: [templateId], references: [id])
  results  Result[]

  @@unique([classId, templateId, term, session])
  @@index([schoolId])
  @@index([templateId])
  @@map("result_batches")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id              String             @id @default(cuid())
  schoolId        String
  billingCycle    BillingCycle
  term            String? // set when billingCycle = PER_TERM
  session         String
  amount          Decimal            @db.Decimal(12, 2)
  discountNote    String?
  // Granted by the platform owner rather than paid for (amount 0).
  isComplimentary Boolean            @default(false)
  // 1, 2 or 3 for a per-term subscription (the term this pays for).
  termNumber      Int?
  // For a full session bought after some terms: what those terms had already paid.
  creditApplied   Decimal            @default(0) @db.Decimal(12, 2)
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([schoolId])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(cuid())
  schoolId          String
  subscriptionId    String?
  paystackReference String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  // The payment made while registering — the only one that gets the new-school discount.
  isRegistration    Boolean       @default(false)
  // What this payment is for, recorded when it starts (the subscription is created when it succeeds).
  billingCycle      BillingCycle?
  termNumber        Int?
  session           String?
  // The price breakdown shown when it started (list price, registration discount,
  // credit for terms already paid) - so the receipt and the subscription's notes
  // stay right even if the owner changes prices before it completes.
  breakdown         Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([schoolId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Deletion requests (School Admin request + Platform Owner approval)
// ---------------------------------------------------------------------------

model DeletionRequest {
  id                String                @id @default(cuid())
  schoolId          String
  requestedByUserId String
  resolvedByUserId  String?
  reason            String
  status            DeletionRequestStatus @default(PENDING)
  requestedAt       DateTime              @default(now())
  resolvedAt        DateTime?
  resolutionNote    String?

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequestedBy", fields: [requestedByUserId], references: [id])
  resolvedBy  User?  @relation("ResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([schoolId])
  @@map("deletion_requests")
}

// ---------------------------------------------------------------------------
// Notifications (SMS/email log)
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  schoolId  String
  studentId String?
  userId    String?
  channel   NotificationChannel
  event     NotificationEvent
  recipient String // phone number or email address
  message   String
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  // Makes a send idempotent: repeating an action (e.g. Publish) finds the
  // existing row instead of messaging the same guardian twice.
  dedupeKey String?             @unique

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Platform-wide provider settings (Platform Owner managed)
// ---------------------------------------------------------------------------

model ProviderSetting {
  id        String       @id @default(cuid())
  provider  ProviderKind @unique
  // Secret keys/config — encrypt at the application layer before storing.
  config    Json
  isActive  Boolean      @default(true)
  updatedAt DateTime     @updatedAt

  @@map("provider_settings")
}

// The subscription prices the platform owner controls (Global settings).
// One row, id "default". Read through src/lib/pricing-settings.ts, which falls
// back to the built-in defaults if the row is missing.
model PricingSettings {
  id                     String   @id @default("default")
  termPrice              Int
  registrationDiscount   Int
  sessionDiscountPercent Int
  updatedAt              DateTime @updatedAt
  updatedById            String?

  @@map("pricing_settings")
}

// The last time something we can only observe from outside happened - a payment
// notification arriving from Paystack, the daily subscription job running - so
// the owner's Go-live page can tell "working" from "never seen". One row per key.
model SystemHeartbeat {
  key    String   @id
  lastAt DateTime

  @@map("system_heartbeats")
}

// Append-only history of price changes: who changed what, and when.
model PricingChange {
  id          String   @id @default(cuid())
  changedAt   DateTime @default(now())
  changedById String?
  before      Json
  after       Json

  @@map("pricing_changes")
}

// ---------------------------------------------------------------------------
// Publication: immutable snapshots + append-only audit log (spec Phase 3)
// ---------------------------------------------------------------------------

// What a parent sees, frozen at publication. The payload is self-contained
// (labels, values and structure baked in) so later template edits can't
// change history. A database trigger rejects any change to the frozen
// columns — only `supersededAt` may be updated (reserved for amendments).
model PublishedResultSnapshot {
  id                   String    @id @default(cuid())
  schoolId             String
  resultId             String
  // Plain string, no FK: the snapshot must outlive batch housekeeping.
  batchId              String?
  studentId            String
  version              Int       @default(1)
  payload              Json
  // SHA-256 of the payload's canonical JSON — detects accidental or
  // unauthorised change.
  checksum             String
  // Short public reference for authenticity checks, e.g. R7K4-P2M9.
  verificationCode     String    @unique
  templateVersionId    String?
  publishedByUserId    String?
  publishedAt          DateTime
  supersededAt         DateTime?
  // Set only on a corrected version (version > 1): why, by whom, and which
  // snapshot it replaced. Frozen with the rest of the record.
  amendmentReason      String?
  amendedByUserId      String?
  supersedesSnapshotId String?
  createdAt            DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, version])
  @@index([schoolId])
  @@index([studentId])
  @@map("published_result_snapshots")
}

// Append-only history of who moved a batch through the workflow, when, why,
// and under which template version. A database trigger blocks UPDATE.
// batchId/resultId are plain strings so history survives row deletion.
model ResultEvent {
  id                String            @id @default(cuid())
  schoolId          String
  batchId           String
  resultId          String?
  action            ResultEventAction
  actorUserId       String?
  actorRole         Role?
  reason            String?
  templateVersionId String?
  metadata          Json?
  createdAt         DateTime          @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([batchId])
  @@index([schoolId, createdAt])
  @@map("result_events")
}

// Which campuses a campus admin (User.campusScoped) may access.
model UserCampusAccess {
  userId    String
  campusId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([userId, campusId])
  @@index([campusId])
  @@map("user_campus_access")
}

// Fixed-window counters for throttling public endpoints (/verify, result
// lookup). In the database because in-memory counters don't survive across
// serverless instances.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Annual summary (spec Phase 4)
// ---------------------------------------------------------------------------

// One row per school; absent means the defaults (equal thirds, hold when a
// term is missing, no annual position). Weights must total 100 before a
// Term 3 result can be submitted.
model AnnualSummarySettings {
  id                   String               @id @default(cuid())
  schoolId             String               @unique
  term1Weight          Decimal              @default(33.33) @db.Decimal(5, 2)
  term2Weight          Decimal              @default(33.33) @db.Decimal(5, 2)
  term3Weight          Decimal              @default(33.34) @db.Decimal(5, 2)
  incompleteYearPolicy IncompleteYearPolicy @default(BLOCK)
  showAnnualPosition   Boolean              @default(false)
  updatedByUserId      String?
  updatedAt            DateTime             @updatedAt
  createdAt            DateTime             @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("annual_summary_settings")
}

// An explicit "this student wasn't there for that term" — the only way to
// resolve a missing earlier term under the hold policy. The term is dropped
// from that student's eligible weights; it is never treated as zero.
model StudentTermException {
  id              String              @id @default(cuid())
  schoolId        String
  studentId       String
  session         String
  termNumber      Int
  status          TermExceptionStatus
  reason          String
  createdByUserId String?
  createdAt       DateTime            @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, session, termNumber])
  @@index([schoolId])
  @@map("student_term_exceptions")
}
